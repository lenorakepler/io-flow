# #############################################################################
# ANALYSIS — FIGURE 4 and TABLES S4/S5  (donor -> recipient transmission)
# QUESTION       : Do transfusions transmit donor anellovirus lineages, do those
#                  lineages persist, and does transmission depend on how similar
#                  the donor lineage is to the recipient's resident lineages?
# PURPOSE        : Classify each donor lineage as transmitted vs not-transmitted
#                  from post-transfusion abundance, then compare within-genus
#                  amino-acid identity across transmitted / not-transmitted /
#                  resident strata.
# INTERPRETATION : Transmitted lineages persist >100 days (to ~260 days), and
#                  transmission is independent of similarity to resident
#                  lineages (median AAI ~32% across strata).
# #############################################################################

# Per-genus amino-acid alignment of study lineages (Alpha/Beta/Gamma), reused by
# Figures 3, 4 and S1.
#   input : ORF1 set + genus labels
#   output: per-genus ORF1 amino-acid FASTA
rule genus_orf1_fasta:
    input:
        orf1  = "results/orfs/orf1.faa",
        genus = "results/typing/contig_genus.tsv",
    output:
        "results/genus/{genus}s_aa.fasta",
    shell:
        "scripts/split_by_genus.py --genus {wildcards.genus} "
        "--labels {input.genus} {input.orf1} > {output}"

# Per-genus amino-acid p-distance matrix (the transmission-strata similarity
# input).
#   input : per-genus ORF1 FASTA
#   output: per-genus p-distance matrix
rule genus_orf1_pmatrix:
    input:
        "results/genus/{genus}s_aa.fasta",
    output:
        "results/genus/{genus}s_aa.p_matrix.tsv",
    shell:
        "scripts/p_distance.py {input} > {output}"

# Classify donor lineages as transmitted (seen in the recipient at >=2 post-
# transfusion timepoints) vs not-transmitted, from the abundance tables.
#   input : all recipient abundance tables
#   output: transmitted and not-transmitted lineage lists
rule classify_transmission:
    input:
        rabund = expand("results/abundance/{recipient}.rabund.final.txt",
                        recipient=RECIPIENTS),
    output:
        transmitted     = "results/transmission/all_donor_transmitted_anellos_2occs.csv",
        not_transmitted = "results/transmission/all_donor_not_transmitted_anellos.csv",
    shell:
        "scripts/classify_transmission.py --rabund {input.rabund} "
        "--transmitted {output.transmitted} "
        "--not-transmitted {output.not_transmitted}"

# Table S4: the transmitted-lineage determination table.
#   input : transmission classification + metadata
#   output: table_S4.csv
rule table_S4:
    input:
        transmitted = "results/transmission/all_donor_transmitted_anellos_2occs.csv",
        metadata    = "resources/metadata/RingTx_transfusion1_metadata.csv",
    output:
        "results/tables/table_S4.csv",
    shell:
        "Rscript scripts/table_S4.R --transmitted {input.transmitted} "
        "--metadata {input.metadata} --out {output}"

# Table S5: transmitted-lineage persistence over the timecourse.
#   input : transmission classification + metadata
