# #############################################################################
# ANALYSIS — NANOPORE VALIDATION
# QUESTION       : Are the short-read assembled contigs real genomes, not
#                  assembly chimeras?
# PURPOSE        : Map independent Oxford Nanopore long reads to a subject's
#                  contigs to confirm they are spanned end-to-end.
# INTERPRETATION : Long reads span the contigs, ruling out chimeric assembly
#                  artifacts.
# #############################################################################

# QC/trim the raw Nanopore reads with porechop, then filtlong.
#   input : raw Nanopore FASTQ
#   output: length-filtered long reads
rule nanopore_filter:
    input:
        "resources/nanopore/{sample}.fastq.gz",
    output:
        "results/nanopore/{sample}.filt.fastq.gz",
    params:
        filtlong = "--min_length 2000 --keep_percent 90",
    shell:
        "porechop -i {input} | filtlong {params.filtlong} - | "
        "gzip > {output}"

# Map filtered long reads to the sample's own assembled contigs with minimap2.
#   input : filtered long reads + that sample's contigs
#   output: alignment (BAM)
rule nanopore_map:
    input:
        reads   = "results/nanopore/{sample}.filt.fastq.gz",
        contigs = "results/assembly/{sample}/contigs.dust.fasta",
    output:
        "results/nanopore/{sample}.bam",
    params:
        preset = "map-ont",
    shell:
        "minimap2 -a -x {params.preset} {input.contigs} {input.reads} | "
        "samtools sort -o {output}"

# Summarise long-read support per contig into the validation report.
#   input : per-sample Nanopore alignments
#   output: validation_report.tsv
rule nanopore_validation_report:
    input:
        expand("results/nanopore/{sample}.bam", sample=SAMPLES),
    output:
        "results/nanopore/validation_report.tsv",
    shell:
        "scripts/nanopore_validate.py {input} > {output}"
