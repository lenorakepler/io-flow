# #############################################################################
# ANALYSIS — FIGURE S3  (pairwise identity across genome features)
# QUESTION       : How divergent are anelloviruses at different parts of the
#                  genome (5'UTR, whole contig, ORF1, ORF2)?
# PURPOSE        : Compute SDT pairwise-identity matrices per feature and show
#                  their identity distributions.
# INTERPRETATION : The non-coding 5'UTR is far more conserved than the coding
#                  ORFs — the split that motivates the separate non-coding
#                  recombination analysis in Figure S5.
# #############################################################################

# SDT (MAFFT-based) pairwise-identity matrix for one genome feature.
#   input : that feature's sequence set
#   output: SDT identity matrix
rule sdt_identity_matrix:
    input:
        "results/features/{feature}.fasta",
    output:
        "results/figure_S3/{feature}_mat.txt",
    shell:
        "scripts/sdt_matrix.sh {input} {output}"

# Render Figure S3 identity-distribution ridges from the four feature matrices.
#   input : SDT matrices for 5'UTR / contig / ORF1 / ORF2
#   output: figure_S3.pdf
rule figure_S3:
    input:
        expand("results/figure_S3/{feature}_mat.txt", feature=SDT_FEATURES),
    output:
        "results/figures/figure_S3.pdf",
    shell:
        "Rscript scripts/figure_S3.R --matrices {input} --out {output}"


# #############################################################################
# ANALYSIS — FIGURE 5  (recombination in the coding region)
# QUESTION       : Does recombination, not just point mutation, generate
#                  anellovirus diversity, and does it break tree-based methods?
# PURPOSE        : Within each within-genus cluster, build trees from adjacent
#                  500-nt windows and measure topological churn (Robinson-Foulds)
#                  along the alignment, and reconstruct recombination tracts with
#                  ClonalFrameML.
# INTERPRETATION : Neighbouring windows give conflicting topologies (high RF) and
#                  ClonalFrameML finds homoplasy tracts — extensive recombination
#                  at all divergence levels confounds a single clonal tree.
# #############################################################################

# Full-length nucleotide alignment for one within-genus cluster.
#   input : that cluster's member sequences
#   output: cluster alignment
rule cluster_alignment:
    input:
        "results/clusters/anello_80.0_{cluster}.fasta",
    output:
        "results/figure_5/anello_80.0_{cluster}.aln.fasta",
    shell:
        "mafft --auto {input} > {output}"

# Full-length ML tree for the cluster with PhyML (HKY+G4). This is the starting
# tree ClonalFrameML re-fits branch lengths onto.
#   input : cluster alignment
#   output: cluster ML tree (Newick)
rule cluster_phyml_tree:
    input:
        "results/figure_5/anello_80.0_{cluster}.aln.fasta",
    output:
        "results/figure_5/anello_80.0_{cluster}.newick",
    params:
        opts = "-b 0 -m HKY85 -f m -t e -v 0 -c 4 -a e -o tlr",
    shell:
        "scripts/phyml_tree.sh {input} '{params.opts}' {output}"

# Cut the cluster alignment into adjacent 500-nt windows and build a PhyML tree
# per window (the inputs to the Robinson-Foulds churn measure).
#   input : cluster alignment
#   output: one Newick tree per 500-nt window
rule cluster_window_trees:
    input:
        "results/figure_5/anello_80.0_{cluster}.aln.fasta",
    output:
        directory("results/figure_5/{cluster}_windows"),
    params:
        window = 500,
        opts   = "-b 0 -m HKY85 -f m -t e -v 0 -c 4 -a e -o tlr",
    shell:
        "scripts/window_trees.sh {input} {params.window} '{params.opts}' {output}"

# Robinson-Foulds distance between adjacent-window trees (ETE3): quantifies how
# much the topology changes along the genome.
#   input : per-window trees
#   output: RF distance profile for the cluster
rule cluster_rf_profile:
    input:
        "results/figure_5/{cluster}_windows",
    output:
        "results/figure_5/{cluster}_rf.tsv",
    shell:
        "scripts/rf_profile.py {input} > {output}"

# ClonalFrameML on the cluster (kappa=2.0): reconstruct recombination tracts and
# re-fit branch lengths accounting for them.
#   input : cluster alignment + starting ML tree
#   output: labelled tree + annotated tree + mutation table
rule cluster_clonalframeml:
    input:
        aln  = "results/figure_5/anello_80.0_{cluster}.aln.fasta",
        tree = "results/figure_5/anello_80.0_{cluster}.newick",
    output:
        labelled  = "results/figure_5/anello_80.0_{cluster}_CFML.labelled_tree.newick",
        annotated = "results/figure_5/anello_80.0_{cluster}_CFML.annotated.tree",
    params:
        kappa = "2.0",
    shell:
        "ClonalFrameML {input.tree} {input.aln} "
        "results/figure_5/anello_80.0_{wildcards.cluster}_CFML "
        "-kappa {params.kappa}"

# Assemble Figure 5 from the RF profiles and ClonalFrameML reconstructions of
# all three clusters.
#   input : per-cluster RF profiles + CFML labelled/annotated trees
#   output: figure_5.pdf
rule figure_5:
    input:
        rf        = expand("results/figure_5/{cluster}_rf.tsv", cluster=CODING_CLUSTERS),
        labelled  = expand("results/figure_5/anello_80.0_{cluster}_CFML.labelled_tree.newick",
                           cluster=CODING_CLUSTERS),
        annotated = expand("results/figure_5/anello_80.0_{cluster}_CFML.annotated.tree",
                           cluster=CODING_CLUSTERS),
    output:
        "results/figures/figure_5.pdf",
    shell:
        "scripts/figure_5.py --rf {input.rf} --annotated {input.annotated} "
        "--out {output}"


# #############################################################################
# ANALYSIS — FIGURE S4  (recombination breakpoints, GARD)
# QUESTION       : How many recombination breakpoints does each genus's
#                  alignment support?
# PURPOSE        : Run GARD (genetic algorithm for recombination detection) per
#                  genus and record the AIC-supported breakpoint count.
# INTERPRETATION : 7-8 breakpoints per genus (Alpha 7, Beta 8, Gamma 7) —
#                  independent confirmation of pervasive recombination.
# #############################################################################

# GARD on a genus alignment (run on the Datamonkey/HyPhy engine).
#   input : per-genus alignment
#   output: GARD result JSON (breakpoints + AIC support)
rule gard_breakpoints:
    input:
        "results/genus/{genus}s_aa.fasta",
    output:
        "results/figure_S4/{genus}_GARD_result.json",
    shell:
        "hyphy gard --alignment {input} --output {output}"

# Summarise the three GARD JSONs into Figure S4.
#   input : per-genus GARD JSONs
#   output: figure_S4.pdf
rule figure_S4:
    input:
        expand("results/figure_S4/{genus}_GARD_result.json", genus=GENERA),
    output:
        "results/figures/figure_S4.pdf",
    shell:
        "scripts/figure_S4.py --gard {input} --out {output}"


# #############################################################################
# ANALYSIS — FIGURE S5  (recombination in non-coding sequence)
# QUESTION       : Does recombination also act on the conserved non-coding
#                  region / 5'UTR, or only in the coding ORFs?
# PURPOSE        : Repeat the ClonalFrameML reconstruction on the non-coding and
#                  5'UTR alignments.
# INTERPRETATION : Recombination tracts appear in non-coding sequence too, so it
#                  is a genome-wide feature, not confined to ORF1.
# #############################################################################

# Align one non-coding sequence set.
#   input : non-coding set sequences
#   output: alignment
rule noncoding_alignment:
    input:
        "results/noncoding/{ncset}.fasta",
    output:
        "results/figure_S5/{ncset}.aln.fasta",
    shell:
        "mafft --auto {input} > {output}"

# Starting ML tree for the non-coding set (PhyML, HKY+G4).
#   input : non-coding alignment
#   output: ML tree
rule noncoding_phyml_tree:
    input:
        "results/figure_S5/{ncset}.aln.fasta",
    output:
        "results/figure_S5/{ncset}.newick",
    params:
        opts = "-b 0 -m HKY85 -f m -t e -v 0 -c 4 -a e -o tlr",
    shell:
        "scripts/phyml_tree.sh {input} '{params.opts}' {output}"

# ClonalFrameML on the non-coding set.
#   input : non-coding alignment + starting tree
#   output: labelled tree + mutation table
rule noncoding_clonalframeml:
    input:
        aln  = "results/figure_S5/{ncset}.aln.fasta",
        tree = "results/figure_S5/{ncset}.newick",
    output:
        labelled  = "results/figure_S5/{ncset}.labelled_tree.newick",
        mutations = "results/figure_S5/{ncset}.mutations.tsv",
    params:
        kappa = "2.0",
    shell:
        "ClonalFrameML {input.tree} {input.aln} results/figure_S5/{wildcards.ncset} "
        "-kappa {params.kappa}"

# Assemble Figure S5 from the non-coding ClonalFrameML reconstructions.
#   input : labelled trees for every non-coding set
#   output: figure_S5.pdf
rule figure_S5:
    input:
        expand("results/figure_S5/{ncset}.labelled_tree.newick", ncset=NONCODING_SETS),
    output:
        "results/figures/figure_S5.pdf",
    shell:
        "scripts/figure_S5.py --trees {input} --out {output}"


# #############################################################################
